<div class="container">

        <h1>🎓 Cadastro Escolar</h1>

        <p class="subtitulo">
            Preencha seus dados para realizar o cadastro
        </p>


        <div class="campo">

            <label for="nome">
                👤 Nome
            </label>

            <input
                type="text"
                id="nome"
                placeholder="Digite seu nome"
            >

        </div>


        <div class="campo">

            <label for="email">
                📧 E-mail
            </label>

            <input
                type="text"
                id="email"
                placeholder="Digite seu e-mail"
            >

        </div>


        <div class="campo">

            <label for="senha">
                🔐 Senha
            </label>

            <input
                type="password"
                id="senha"
                placeholder="Digite sua senha"
            >

        </div>


        <div class="regras">

            <h3>🔎 Regras da senha</h3>

         <p id="regraTamanho">⚪ Pelo menos 8 caracteres</p>

    <p id="regraMaiuscula">⚪ Pelo menos uma letra MAIÚSCULA</p>

    <p id="regraNumero">⚪ Pelo menos um número</p>

        </div>


        <button type="button" id="botao">

            🚀 Cadastrar

        </button>


        <div id="mensagem"></div>

    </div> 
{
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


body {
    font-family: Arial, sans-serif;

    background: linear-gradient(135deg, #667eea, #764ba2);

    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 20px;
}


.container {
    background-color: white;

    width: 100%;

    max-width: 450px;

    padding: 35px;

    border-radius: 20px;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}


h1 {
    text-align: center;

    color: #4a4a4a;

    margin-bottom: 10px;
}


.subtitulo {
    text-align: center;

    color: #777;

    margin-bottom: 30px;
}


.campo {
    margin-bottom: 20px;
}


.campo label {
    display: block;

    font-weight: bold;

    color: #444;

    margin-bottom: 8px;
}


.campo input {
    width: 100%;

    padding: 13px;

    border: 2px solid #ddd;

    border-radius: 10px;

    font-size: 16px;

    outline: none;

    transition: 0.3s;
}


.campo input:focus {
    border-color: #667eea;

    box-shadow: 0 0 5px rgba(102, 126, 234, 0.4);
}


.regras {
    background-color: #f3f4ff;

    border-left: 5px solid #667eea;

    padding: 15px;

    border-radius: 8px;

    margin-bottom: 25px;
}


.regras h3 {
    color: #4c51bf;

    margin-bottom: 10px;
}


.regras p {
    color: #555;

    margin: 5px 0;
}


button {
    width: 100%;

    padding: 14px;

    border: none;

    border-radius: 10px;

    background-color: #667eea;

    color: white;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;
}


button:hover {
    background-color: #4c51bf;

    transform: scale(1.02);
}


#mensagem {
    margin-top: 20px;

    font-size: 17px;
}


.sucesso {
    color: #16803c;

    background-color: #d9fbe5;

    padding: 18px;

    border-radius: 10px;
}


.sucesso h2 {
    text-align: center;

    margin-bottom: 15px;
}


.sucesso p {
    margin: 8px 0;

    color: #333;
}

